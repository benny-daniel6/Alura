# Production settings for docker-compose.prod.yml. Copy to backend/.env.production and fill in.
# ENVIRONMENT, DATABASE_URL and REDIS_URL are set by docker-compose.prod.yml.

PROJECT_NAME="Alura AI Wardrobe & Styling API"

# --- Sign-in -----------------------------------------------------------------------------
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional "Continue with Google": the OAuth *Web* client ID from Google Cloud console (JSON list)
GOOGLE_OAUTH_CLIENT_IDS=[]
# Optional legacy Firebase sign-in: service-account JSON mounted at /run/secrets
FIREBASE_CREDENTIALS_PATH=

# --- Photo storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO) ----------
S3_ENDPOINT_URL=            # empty for AWS S3; e.g. https://<account>.r2.cloudflarestorage.com for R2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=aura-assets
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=         # public URL/CDN prefix for stored photos, e.g. https://cdn.example.com

# --- AI (optional) ------------------------------------------------------------------------
# Without a key: local cutouts + OpenCLIP tags, and the rule-based stylist.
GEMINI_API_KEY=
GARMENT_IMAGE_PROVIDER=gemini
REMBG_MODEL=u2net
STYLIST_PROVIDER=gemini

# --- Web ----------------------------------------------------------------------------------
# The mobile app needs no CORS; list web front-end origins here if you add one.
BACKEND_CORS_ORIGINS=["https://example.com"]
WEB_CONCURRENCY=2
