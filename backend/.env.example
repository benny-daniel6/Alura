# Environment
# Dev-only behaviour (dev-token auth bypass, local disk storage, heuristic ML fallbacks) is enabled ONLY
# when ENVIRONMENT=development (ENV=development also works). The app defaults to production if unset.
ENVIRONMENT=development
PROJECT_NAME="Alura AI Wardrobe & Styling API"
API_V1_STR="/api/v1"

# Database (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aura_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aura_db

# Firebase Auth
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=aura-wardrobe-dev
# Enable bypass mode for local development without live Firebase credentials
DEV_AUTH_BYPASS=true

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO Storage (required outside development; development stores files under data/storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aura-assets
S3_REGION=us-east-1
# Public URL prefix for stored objects (CDN or bucket URL). Defaults to <endpoint>/<bucket>.
S3_PUBLIC_BASE_URL=

# Google Gemini (studio product photos, garment tagging, AI stylist). Get a key at https://aistudio.google.com/apikey
# Leave empty to use the local pipeline (rembg + OpenCLIP) and the rule-based stylist.
# Keep this key on the server only; never ship it inside the mobile app.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# gemini = white-background product shot from Gemini, then cutout; local = cutout from the user's photo only
GARMENT_IMAGE_PROVIDER=gemini
# Cutout model: u2net (fast, default) or birefnet-general (slightly cleaner, GPU only: ~8 GB RAM, ~23 s/photo on CPU)
REMBG_MODEL=u2net
# Stylist engine: gemini | openai | rules  (openai uses LLM_API_KEY / LLM_API_BASE_URL / LLM_MODEL)
STYLIST_PROVIDER=gemini

# CORS
BACKEND_CORS_ORIGINS=["*"]
